# Environment variables for Match & Catch Game

# Database Configuration (MySQL/RDS)
# DB_HOST=your-rds-endpoint.rds.amazonaws.com
# DB_PORT=3306
# DB_NAME=match_and_catch
# DB_USER=admin
# DB_PASSWORD=your-password
# DATABASE_URL=mysql://user:password@host:port/dbname

# Game Configuration
EVENT_ID=event-techfest-2026
EVENT_NAME=Match & Catch AWS x Google Cloud Challenge
REWARD_THRESHOLD=12

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=*

# Security
SECRET_KEY=django-insecure-match-and-catch-2026-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
